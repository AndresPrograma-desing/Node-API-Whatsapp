                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/connect",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "connect"
                            ]
                        },
                        "description": "Disponible si usas el montaje definido en src/app.js con session.routes.js."
                    }
                },
                {
                    "name": "Status (session.controller)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "x-api-key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/status",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "status"
                            ]
                        },
                        "description": "Disponible si usas el montaje definido en src/app.js con session.routes.js."
                    }
                }
            ]
        }
