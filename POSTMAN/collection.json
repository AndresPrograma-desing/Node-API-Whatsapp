{
    "info": {
        "name": "Node API Whatsapp - Workspace Collection",
        "description": "Coleccion creada desde el codigo fuente para probar endpoints de mensajes, sesiones y tenants.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "a5d8a67f-5479-4aa3-9dce-189254c3801d"
    },
    "item": [
        {
            "name": "Mensaje",
            "item": [
                {
                    "name": "Enviar factura PDF",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-api-key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"numero\": \"{{numeroDestino}}\",\n  \"cliente\": \"Cliente de Prueba\",\n  \"Url\": \"\",\n  \"nombreEmpresa\": \"Empresa Demostración C.A.\",\n  \"mensaje\": \"Hola, adjuntamos la factura correspondiente a los servicios prestados de forma digital.\",\n  \"invoiceData\": {\n    \"invoiceId\": \"FAC-2026-0001\",\n    \"dates\": {\n      \"emission\": \"01/01/2026\",\n      \"expiration\": \"15/01/2026\"\n    },\n    \"emitter\": {\n      \"companyName\": \"Empresa Demostración C.A.\",\n      \"taxId\": \"J-00000000-0\",\n      \"address\": \"Calle Falsa 123, Distrito Capital, Caracas\",\n      \"phone\": \"+58 412-0000000\",\n      \"email\": \"soporte@empresademo.com\"\n    },\n    \"client\": {\n      \"fullName\": \"Usuario Genérico de Prueba\",\n      \"taxId\": \"V-00000000\",\n      \"address\": \"Avenida Principal, Urbanización Imaginaria, Piso 1, Caracas\"\n    },\n    \"payment\": {\n      \"method\": \"Transferencia Bancaria\",\n      \"currency\": \"USD\",\n      \"currencySymbol\": \"$\",\n      \"accountNumber\": \"TX-00000-BK\",\n      \"taxPercentage\": 16\n    },\n    \"items\": [\n      {\n        \"name\": \"Servicio de Consultoría Técnica y Desarrollo de Software Integrado\",\n        \"qty\": 1,\n        \"price\": 100.00\n      }\n    ]\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/send-invoice",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "send-invoice"
                            ]
                        },
                        "description": "Envio de PDF por WhatsApp. Detecta el objeto invoiceData para generar el PDF dinámicamente con datos dummy de prueba."
                    }
                },
                {
                    "name": "Iniciar sesion tenant",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-api-key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"clientId\": \"{{clientId}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/init-session",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "init-session"
                            ]
                        },
                        "description": "Arranca una sesion de WhatsApp para el clientId indicado."
                    }
                },
                {
                    "name": "Estado por clientId",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "x-api-key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/status/{{clientId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "status",
                                "{{clientId}}"
                            ]
                        },
                        "description": "Consulta el estado de una instancia tenant especifica."
                    }
                },
                {
                    "name": "Listar clientes",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "x-api-key",
                                "value": "{{apiKey}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/clients",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "clients"
                            ]
                        },
                        "description": "Obtiene todos los clientes registrados en DB."
                    }
                }
            ]
        },
        {
            "name": "Tenant",
            "item": [
                {
                    "name": "Registrar tenant",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"id\": \"{{tenantId}}\",\n  \"name\": \"{{tenantName}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/WSMessage/tenants/register-tenant",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "WSMessage",
                                "tenants",
                                "register-tenant"
                            ]
                        },
                        "description": "Crea un nuevo tenant en la base de datos."
                    }
                }
            ]
        },
        {
